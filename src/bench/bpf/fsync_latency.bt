// Histogram of fsync() latency (us) for a specific PID.
// {{PID}} is replaced by the BpfRunner before execution.
//
// Rides the syscalls tracepoints (stable ABI, arch-neutral) rather than
// arch-prefixed kprobes, which do not exist off x86_64. No BEGIN/END on
// purpose: maps auto-print at exit, and stripped distro bpftrace builds
// cannot run BEGIN/END trigger uprobes.

tracepoint:syscalls:sys_enter_fsync /pid == {{PID}}/ {
  @start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_fsync /@start[tid]/ {
  @fsync_latency_us = hist((nsecs - @start[tid]) / 1000);
  delete(@start[tid]);
}

tracepoint:sched:sched_process_exit /pid == {{PID}}/ {
  exit();
}
