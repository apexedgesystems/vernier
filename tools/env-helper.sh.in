#!/bin/bash
# Auto-generated by @PROJECT_NAME@ tools/CMakeLists.txt via configure_file.
# Run at build time to append @PROJECT_NAME@'s CLI-tool PATH entries to the
# build .env file. Idempotent: lines are added only if the absolute path key
# is not already present, so re-running across rebuilds is safe and parent
# projects' own .env writers continue to coexist with this one.

set -e
ENV_FILE="@_ENV_FILE@"

add_if_missing() {
  local key="$1" line="$2"
  grep -qF "$key" "$ENV_FILE" 2>/dev/null || printf '%s\n' "$line" >> "$ENV_FILE"
}

touch "$ENV_FILE"
add_if_missing '@CMAKE_BINARY_DIR@/bin/tools/rust' \
  'export PATH="@CMAKE_BINARY_DIR@/bin/tools/rust:$PATH"'
add_if_missing '@CMAKE_BINARY_DIR@/bin/tools/py' \
  'export PATH="@CMAKE_BINARY_DIR@/bin/tools/py:$PATH"'
add_if_missing '@CMAKE_BINARY_DIR@/lib/python' \
  'export PYTHONPATH="@CMAKE_BINARY_DIR@/lib/python:${PYTHONPATH:-}"'
